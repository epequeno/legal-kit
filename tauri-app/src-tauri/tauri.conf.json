{
  "productName": "LegalKit",
  "version": "0.1.0",
  "identifier": "com.legalkit.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LegalKit",
        "width": 1280,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 640,
        "resizable": true,
        "devtools": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}